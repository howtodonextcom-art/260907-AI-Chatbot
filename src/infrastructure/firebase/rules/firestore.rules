rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /workspaces/{workspaceId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      // ownerId must never change on update — otherwise an owner could
      // transfer/hijack a workspace by rewriting ownerId to another uid.
      allow update: if isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;

      match /sessions/{sessionId} {
        allow read: if isOwner(resource.data.ownerId);
        allow create: if request.auth != null
          && request.resource.data.ownerId == request.auth.uid;
        // DECIDED must only ever be written by the server (Admin SDK,
        // which bypasses these rules) after HardPolicyGate + DecisionRecord
        // creation. judgeDraft/activeDecisionRecordId/activeBlueprintId are
        // server-controlled and must never be set by a client write.
        allow update: if isOwner(resource.data.ownerId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.workspaceId == resource.data.workspaceId
          && request.resource.data.status != 'DECIDED'
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['judgeDraft', 'activeDecisionRecordId', 'activeBlueprintId']);
        allow delete: if false;

        match /messages/{messageId} {
          allow read: if isOwner(resource.data.ownerId);
          allow create: if request.auth != null
            && request.resource.data.ownerId == request.auth.uid;
          allow update, delete: if false;
        }

        match /evidence/{evidenceId} {
          allow read: if isOwner(resource.data.ownerId);
          allow create: if request.auth != null
            && request.resource.data.ownerId == request.auth.uid;
          allow update, delete: if false;
        }

        match /agentRuns/{runId} {
          allow read: if isOwner(resource.data.ownerId);
          allow write: if false;
        }

        match /experiments/{experimentId} {
          allow read: if isOwner(resource.data.ownerId);
          allow write: if false;
        }
      }
    }

    match /decisionRecords/{id} {
      allow read: if isOwner(resource.data.ownerId);
      allow create, update, delete: if false;
    }

    match /blueprints/{id} {
      allow read: if isOwner(resource.data.ownerId);
      allow create, update, delete: if false;
    }
  }
}
